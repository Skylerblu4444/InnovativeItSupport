[build]
  command = "npm run build"
  publish = ".next"{
  "name": "innovative-it-support",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/backend/server.ts",
    "build": "tsc -p .",
    "start": "node dist/backend/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "pg": "^8.9.0",
    "stripe": "^12.0.0",
    "openai": "^4.0.0",
    "bcrypt": "^5.1.0",
    "zod": "^3.20.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "eslint": "^8.39.0",
    "prettier": "^2.8.8"
  }
}
{
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  }
}
